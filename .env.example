# Copy this file to `.env` and fill in real values. `.env` is gitignored.
#
# Local Postgres connection string used by both the app (lib/db.ts) and the
# migration runner (scripts/migrate.mjs).
#   postgres://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgres://postgres:postgres@localhost:5432/lifeline

# First-run setup (see first-run/). On server start, if no admin user
# exists, one is created. Staff sign in with their phone number. Optional —
# sensible defaults are used if unset:
#   - admin phone defaults to "0000000000"
#   - if no password is set, a strong random one is generated and printed to the
#     server console ONCE. Set FIRST_RUN_ADMIN_PASSWORD to choose your own.
FIRST_RUN_LOCATION_NAME=Life Line Hospital
FIRST_RUN_ADMIN_PHONE=0000000000
# FIRST_RUN_ADMIN_PASSWORD=change-me-on-first-login

# Break-glass SUPER ADMIN (see lib/auth/super-admin.ts). Unlike FIRST_RUN_* above,
# which only ever runs when there is no admin at all, this account is re-asserted on
# EVERY server start:
#   deleted        → recreated       demoted   → forced back to admin
#   deactivated    → reactivated     password  → reset to the value below
# It also cannot be edited, deactivated or password-reset from the Staff screen. So a
# restart is always a way back in after a lock-out. BOTH lines must be set, or no super
# admin is created (a half-configured pair logs a warning at boot). Staff sign in by
# phone, so SUPER_ADMIN_PHONE is the login and must not collide with a real staff
# member's number. SUPER_ADMIN_NAME is optional and defaults to "Super Admin".
# SUPER_ADMIN_PHONE=9999999999
# SUPER_ADMIN_PASSWORD=
# SUPER_ADMIN_NAME=Super Admin

# Secret used to sign session cookies (HMAC). Required — auth refuses to run
# without it. Generate a strong value with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

# Where patient documents (scans / case studies) are stored on disk. The app
# creates "Life_Line_Hospital_Documents" under this path on first use, with
# IPD\ and OPD\ subfolders and one folder per admission/consultation.
# Typically a drive root, e.g. D:\ - falls back to C:\ if unset.
DOCUMENTS_ROOT=D:\
